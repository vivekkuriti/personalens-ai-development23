# Required
GEMINI_API_KEY=your-gemini-api-key

# Optional
GEMINI_MODEL=gemini-3.5-flash
GEMINI_SEND_SCREENSHOTS=true
HEADLESS=true
DEFAULT_MAX_STEPS=15
HARD_MAX_STEPS=40
NAVIGATION_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=8000
SLOW_PAGE_THRESHOLD_MS=4000
MAX_AXE_SCANS_PER_PERSONA=5
# DATABASE_URL=sqlite:///artifacts/personaux.db

# Dedicated test identity used when personas fill forms (never use real credentials)
TEST_ACCOUNT_EMAIL=personaux.tester@example.com
# TEST_ACCOUNT_PASSWORD=   # random per process if unset
TEST_ACCOUNT_NAME=Test User
TEST_ACCOUNT_PHONE=5550100123
